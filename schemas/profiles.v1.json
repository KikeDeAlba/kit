{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KikeDeAlba/kit/main/schemas/profiles.v1.json",
  "title": "kikedealba profiles v1",
  "type": "object",
  "required": ["version", "default", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "default": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "profiles": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["builtin"],
            "properties": {
              "builtin": { "const": true },
              "createdAt": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["claude", "codex"],
            "properties": {
              "builtin": { "const": false },
              "claude": { "type": "string", "minLength": 1 },
              "codex": { "type": "string", "minLength": 1 },
              "createdAt": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dirs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "profile"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
